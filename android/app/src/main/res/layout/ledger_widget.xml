<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background_dark"
    android:padding="14dp">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ledger"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_last_updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="• Updated Just Now"
            android:textColor="#A1A1AA"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Attractive + New Button -->
        <TextView
            android:id="@+id/widget_add_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ New"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/widget_add_btn_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginEnd="8dp" />

        <!-- Vector Refresh Button -->
        <ImageView
            android:id="@+id/widget_refresh_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_widget_refresh"
            android:background="@drawable/widget_icon_btn_bg"
            android:padding="6dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- Empty State View -->
    <LinearLayout
        android:id="@+id/widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📝"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/widget_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No recent transactions"
            android:textColor="#A1A1AA"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Scrollable ListView of ALL Chats/Contacts -->
    <ListView
        android:id="@+id/widget_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="6dp"
        android:scrollbars="none" />

</LinearLayout>
