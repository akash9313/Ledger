rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile & Accounts Isolation Rule
    match /users/{userId} {
      // User can only read & write their own profile document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcollection: Ledger Accounts / Chats
      match /ledger_chats/{chatId} {
        // Strict Isolation: User can ONLY access their own ledger accounts
        allow read, write, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: Custom Categories (if created)
      match /categories/{categoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default Deny-All rule for any unspecified paths to prevent unauthorized data access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
